// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusAktif {
  AKTIF
  TIDAK_AKTIF @map("TIDAK AKTIF")
}

enum MetodeSpk {
  PROFILE_MATCHING
  SAW
  WP
  TOPSIS
}

enum JenisAtribut {
  BENEFIT
  COST
}

enum JenisFaktor {
  CORE
  SECONDARY
}

enum StatusPeminjaman {
  DITERIMA
  DITOLAK
  DIPROSES
  MENUNGGU_SPK
}

enum Role {
  SUPER_ADMIN @map("SUPER ADMIN")
  ADMIN
}

enum TingkatRisiko {
  RENDAH
  MENENGAH
  TINGGI
}

model PenyediaJasa {
  idPenyediaJasa    Int         @id @default(autoincrement()) @map("id_penyedia_jasa")
  namaPenyediaJasa  String      @map("nama_penyedia_jasa") @db.VarChar(50)
  alamat            String      @db.VarChar(255)
  statusAktif       StatusAktif @default(AKTIF) @map("status_aktif")
  
  // Kolom batasan pengajuan dari Penyedia Jasa
  limitPengajuan    Decimal     @default(0) @map("limit_pengajuan") @db.Decimal(15, 2)
  limitTenor        Int         @default(12) @map("limit_tenor")

  // Bobot persentase CF & SF global untuk Penyedia Jasa
  persentaseCf      Decimal     @default(60.00) @map("persentase_cf") @db.Decimal(5, 2)
  persentaseSf      Decimal     @default(40.00) @map("persentase_sf") @db.Decimal(5, 2)


  kriteria  Kriteria[]
  pengajuan Pengajuan[]
  users     Users[]

  @@map("penyedia_jasa")
}

model Kriteria {
  idKriteria     Int         @id @default(autoincrement()) @map("id_kriteria")
  idPenyediaJasa Int         @map("id_penyedia_jasa")
  kodeKriteria   String       @map("kode_kriteria") @db.Char(5)
  namaKriteria   String       @map("nama_kriteria") @db.VarChar(100)
  
  // Properti PM
  nilaiTarget    Int          @default(3) @map("nilai_target")
  jenisFaktor    JenisFaktor  @default(CORE) @map("jenis_faktor")

  // Properti SAW, WP, TOPSIS
  bobot          Decimal      @default(0.00) @db.Decimal(5, 2)
  jenisAtribut   JenisAtribut @default(BENEFIT) @map("jenis_atribut")

  penyediaJasa   PenyediaJasa @relation(fields: [idPenyediaJasa], references: [idPenyediaJasa], onDelete: Cascade, onUpdate: Cascade)
  subKriteria    SubKriteria[]

  @@map("kriteria")
}

model SubKriteria {
  idSub       Int      @id @default(autoincrement()) @map("id_sub")
  idKriteria  Int      @map("id_kriteria")
  deskripsi   String   @db.VarChar(255)
  nilaiRating Int      @map("nilai_rating")

  kriteria  Kriteria    @relation(fields: [idKriteria], references: [idKriteria], onDelete: Cascade, onUpdate: Cascade)
  penilaian Penilaian[]

  @@map("sub_kriteria")
}

model Nasabah {
  idNasabah   Int      @id @default(autoincrement()) @map("id_nasabah")
  namaNasabah String   @map("nama_nasabah") @db.VarChar(50)
  nik         String   @db.VarChar(255)
  telepon     String   @db.VarChar(20)
  alamat      String   @db.VarChar(255)
  password    String   @db.VarChar(255)
  email       String   @unique @db.VarChar(50)

  pengajuan Pengajuan[]

  @@map("nasabah")
}

model Pengajuan {
  idPengajuan      Int              @id @default(autoincrement()) @map("id_pengajuan")
  tanggalPengajuan DateTime         @map("tanggal_pengajuan") @db.Date
  statusPeminjaman StatusPeminjaman @default(DIPROSES) @map("status_peminjaman")
  idNasabah        Int              @map("id_nasabah")
  idPenyediaJasa   Int              @map("id_penyedia_jasa")
  jumlahKredit     Decimal          @map("jumlah_kredit") @db.Decimal(15, 2)
  lamaTenor        Int              @map("lama_tenor")

  nasabah      Nasabah      @relation(fields: [idNasabah], references: [idNasabah], onDelete: Cascade, onUpdate: Cascade)
  penyediaJasa PenyediaJasa @relation(fields: [idPenyediaJasa], references: [idPenyediaJasa], onDelete: Cascade, onUpdate: Cascade)
  penilaian    Penilaian[]
  
  survey       SurveyLapangan?

  @@map("pengajuan")
}

model SurveyLapangan {
  idSurvey            Int             @id @default(autoincrement()) @map("id_survey")
  idPengajuan         Int             @unique @map("id_pengajuan")
  skorProfileMatching Decimal?        @map("skor_profile_matching") @db.Decimal(5, 2)
  skorSaw             Decimal?        @default(0) @map("skor_saw") @db.Decimal(5, 2)
  skorWp              Decimal?        @default(0) @map("skor_wp") @db.Decimal(5, 2)
  skorTopsis          Decimal?        @default(0) @map("skor_topsis") @db.Decimal(5, 2)
  tingkatRisiko       TingkatRisiko?  @map("tingkat_risiko")

  pengajuan           Pengajuan       @relation(fields: [idPengajuan], references: [idPengajuan], onDelete: Cascade, onUpdate: Cascade)

  @@map("survey_lapangan")
}

model Penilaian {
  idPenilaian Int @id @default(autoincrement()) @map("id_penilaian")
  idPengajuan Int @map("id_pengajuan")
  idSub       Int @map("id_sub")

  pengajuan   Pengajuan   @relation(fields: [idPengajuan], references: [idPengajuan], onDelete: Cascade, onUpdate: Cascade)
  subKriteria SubKriteria @relation(fields: [idSub], references: [idSub], onDelete: Cascade, onUpdate: Cascade)

  @@map("penilaian")
}

model BobotGap {
  idBobotGap Int     @id @default(autoincrement()) @map("id_bobot_gap")
  selisihGap Int     @map("selisih_gap")
  bobotNilai Decimal @map("bobot_nilai") @db.Decimal(4, 2)
  keterangan String? @db.VarChar(50)

  @@map("bobot_gap")
}

model Users {
  idUser         Int           @id @default(autoincrement()) @map("id_user")
  username       String        @db.VarChar(50)
  password       String        @db.VarChar(255)
  email          String        @unique @db.VarChar(50)
  role           Role
  idPenyediaJasa Int?          @map("id_penyedia_jasa")

  penyediaJasa   PenyediaJasa? @relation(fields: [idPenyediaJasa], references: [idPenyediaJasa], onDelete: Cascade, onUpdate: Cascade)

  @@map("users")
}
